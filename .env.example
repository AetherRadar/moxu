# MoXu launcher settings; no credentials.
# start.sh / start.ps1 DO NOT automatically load a root .env file.
# Set these variables in your terminal, or on macOS/Linux manually load a
# trusted copy from the repository root: set -a; . ./.env; set +a
# Windows PowerShell: $env:MOXU_BACKEND_PORT = '8080'
# Vite separately loads web/.env*; the root launcher overrides its ports
# and backend HTTP/WS URLs so they match the Java process it starts.

MOXU_BACKEND_PORT=8080
MOXU_FRONTEND_PORT=3000

# Concurrent read-only chapter analysis stages (1-4). Default 2 overlaps summary
# and canon extraction without changing models, prompts, or validation.
# Use 1 for providers that permit only one concurrent request.
MOXU_ANALYSIS_CONCURRENCY=2

# Omit to use <repository root>/data. Relative paths are relative to that root.
# MOXU_DATA_DIR=/absolute/path/to/data

# Optional JDK selection; JDK 21 is recommended. Keep JAVA_HOME/bin on PATH.
# JAVA_HOME=/absolute/path/to/jdk-21

# LLM profiles and assignments remain in data/; configure them in the app.
# There is no Python .env import or automatic provider-key migration.
# Default local polishing model, already imported into Ollama: moxu-polish:qwen3-1.7b.
# Numeric protection restores original numbers/units using context alignment.
# Missing/added numbers or ambiguous alignment retain the original selection with a warning.
# Apply only after frontend diff confirmation; general-purpose LLM is a manual
# alternative with no automatic fallback. This model is not an AI-text detector.
# Ollama is managed separately; these launchers do not start or stop it.
MOXU_POLISH_BASE_URL=http://127.0.0.1:11434
MOXU_POLISH_MODEL=moxu-polish:qwen3-1.7b
MOXU_POLISH_TIMEOUT_SECONDS=120
